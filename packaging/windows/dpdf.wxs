<?xml version="1.0" encoding="utf-8"?>
<!--
  dpdf MSI (WiX Toolset v5: `dotnet tool install -g wix`).
  Per-user (default, no admin required) or Per-machine install, Start Menu shortcut, desktop shortcut,
  App Paths entry, dpdf registered as a PDF handler, "Edit with dpdf" on PDF files' right-click menu,
  and "Create PDF with dpdf…" on image files' right-click menu.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="dpdf"
      Manufacturer="Divya"
      Version="$(var.Version)"
      UpgradeCode="EA00C367-7270-4C50-9D8B-A7A5C88AD27F"
      Scope="perUserOrMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="dpdf PDF workbench" Manufacturer="Divya" />
    <!-- Supports both per-user (no admin rights required) and per-machine (with admin approval) installations. -->
    <Property Id="INSTALLSCOPE" Value="perUser" Secure="yes" />
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of dpdf is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="DpdfIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DpdfIcon.ico" />

    <Property Id="INSTALLDESKTOPSHORTCUT" Secure="yes" />
    <Property Id="EXISTINGDESKTOPSHORTCUT">
      <DirectorySearch Id="DesktopSearch" Path="[DesktopFolder]" Depth="0">
        <FileSearch Name="dpdf.lnk" />
      </DirectorySearch>
    </Property>
    <SetProperty Id="INSTALLDESKTOPSHORTCUT" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT INSTALLDESKTOPSHORTCUT AND (NOT WIX_UPGRADE_DETECTED OR EXISTINGDESKTOPSHORTCUT)" />

    <Upgrade Id="EA00C367-7270-4C50-9D8B-A7A5C88AD27F">
      <UpgradeVersion Minimum="0.7.1" IncludeMinimum="yes" OnlyDetect="yes" Property="PDFCONTEXTMENURELEASE" />
      <UpgradeVersion Minimum="0.4.0" IncludeMinimum="yes" OnlyDetect="yes" Property="IMAGECONTEXTMENURELEASE" />
    </Upgrade>
    <Property Id="INSTALLPDFCONTEXTMENU" Secure="yes" />
    <Property Id="EXISTINGPDFCONTEXTMENU">
      <RegistrySearch Id="PdfContextMenuSearch" Root="HKCR" Key="SystemFileAssociations\.pdf\shell\dpdf.Edit" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLPDFCONTEXTMENU" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT INSTALLPDFCONTEXTMENU AND (NOT PDFCONTEXTMENURELEASE OR EXISTINGPDFCONTEXTMENU)" />
    <Property Id="INSTALLIMAGECONTEXTMENU" Secure="yes" />
    <Property Id="EXISTINGIMAGECONTEXTMENU">
      <RegistrySearch Id="ImageContextMenuSearch" Root="HKCR" Key="SystemFileAssociations\.png\shell\dpdf.CreatePdf" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLIMAGECONTEXTMENU" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT INSTALLIMAGECONTEXTMENU AND (NOT IMAGECONTEXTMENURELEASE OR EXISTINGIMAGECONTEXTMENU)" />
    <UIRef Id="DpdfInstallerUI" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="dpdf">
        <Directory Id="ModelsFolder" Name="models" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="dpdf" Level="1">
      <ComponentGroupRef Id="DpdfFiles" />
      <ComponentGroupRef Id="DpdfModels" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="DpdfFiles" Directory="INSTALLFOLDER">
      <Component Id="DpdfApp" Guid="E724C1C6-091F-4E21-A685-80D089FDBE21">
        <File Id="DpdfExe" Source="$(var.BinDir)\dpdf.exe" KeyPath="yes" />

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\dpdf.exe" Value="[#DpdfExe]" Type="string" />

        <RegistryValue Root="HKMU" Key="Software\Classes\dpdf.Document" Value="PDF Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\dpdf.Document\DefaultIcon" Value="&quot;[#DpdfExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\dpdf.Document\shell\open\command" Value="&quot;[#DpdfExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\dpdf.Document" Name="TypeOverlay" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.pdf\OpenWithProgids" Name="dpdf.Document" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\dpdf.exe" Name="FriendlyAppName" Value="dpdf" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\dpdf.exe\DefaultIcon" Value="&quot;[#DpdfExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\dpdf.exe\SupportedTypes" Name=".pdf" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\dpdf.exe\shell\open\command" Value="&quot;[#DpdfExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\dpdf\Capabilities" Name="ApplicationName" Value="dpdf" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\dpdf\Capabilities" Name="ApplicationDescription" Value="dpdf PDF workbench" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\dpdf\Capabilities" Name="ApplicationIcon" Value="[#DpdfExe],0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\dpdf\Capabilities\FileAssociations" Name=".pdf" Value="dpdf.Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="dpdf" Value="Software\dpdf\Capabilities" Type="string" />
      </Component>

      <Component Id="DpdfStartMenuShortcut" Directory="ProgramMenuFolder" Guid="DC028192-C233-4F99-9A77-ED458C60DF26">
        <Shortcut Id="StartMenuShortcut" Name="dpdf" Description="dpdf PDF workbench"
            Target="[#DpdfExe]" WorkingDirectory="INSTALLFOLDER" Icon="DpdfIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\dpdf\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="DpdfDesktopShortcut" Directory="DesktopFolder" Guid="F6948627-32AB-4D78-8865-0FDF417CE442"
          Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="DesktopShortcut" Name="dpdf" Description="dpdf PDF workbench"
            Target="[#DpdfExe]" WorkingDirectory="INSTALLFOLDER" Icon="DpdfIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\dpdf\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="DpdfPdfContextMenu" Guid="439F084F-657D-4AC2-A4CC-F099C518D71F"
          Condition="INSTALLPDFCONTEXTMENU = 1">
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\dpdf.Edit" Value="Edit with dpdf" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\dpdf.Edit" Name="Icon" Value="&quot;[#DpdfExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\dpdf.Edit" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\dpdf.Edit\command" Value="&quot;[#DpdfExe]&quot; &quot;%1&quot;" Type="string" />
      </Component>

      <Component Id="DpdfImageContextMenu" Guid="1B783BF3-12DF-4588-AF80-E2CEA8BC1E5A"
          Condition="INSTALLIMAGECONTEXTMENU = 1">
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.png\shell\dpdf.CreatePdf" Value="Create PDF with dpdf…" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.png\shell\dpdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.png\shell\dpdf.CreatePdf\command" Value="&quot;[#DpdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\dpdf.CreatePdf" Value="Create PDF with dpdf…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\dpdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\dpdf.CreatePdf\command" Value="&quot;[#DpdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\dpdf.CreatePdf" Value="Create PDF with dpdf…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\dpdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\dpdf.CreatePdf\command" Value="&quot;[#DpdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tif\shell\dpdf.CreatePdf" Value="Create PDF with dpdf…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tif\shell\dpdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tif\shell\dpdf.CreatePdf\command" Value="&quot;[#DpdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\dpdf.CreatePdf" Value="Create PDF with dpdf…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\dpdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\dpdf.CreatePdf\command" Value="&quot;[#DpdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gif\shell\dpdf.CreatePdf" Value="Create PDF with dpdf…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gif\shell\dpdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gif\shell\dpdf.CreatePdf\command" Value="&quot;[#DpdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\dpdf.CreatePdf" Value="Create PDF with dpdf…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\dpdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\dpdf.CreatePdf\command" Value="&quot;[#DpdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jp2\shell\dpdf.CreatePdf" Value="Create PDF with dpdf…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jp2\shell\dpdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jp2\shell\dpdf.CreatePdf\command" Value="&quot;[#DpdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.j2k\shell\dpdf.CreatePdf" Value="Create PDF with dpdf…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.j2k\shell\dpdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.j2k\shell\dpdf.CreatePdf\command" Value="&quot;[#DpdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpx\shell\dpdf.CreatePdf" Value="Create PDF with dpdf…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpx\shell\dpdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpx\shell\dpdf.CreatePdf\command" Value="&quot;[#DpdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
      </Component>

      <Component Id="DpdfCli">
        <File Id="DpdfCliExe" Source="$(var.BinDir)\dpdf-cli.exe" KeyPath="yes" />
      </Component>
      <Component Id="DpdfDocumentIconLicense">
        <File Id="DpdfDocumentIconLicenseFile" Source="$(var.BinDir)\LICENSE-document.txt" KeyPath="yes" />
      </Component>
      <Component Id="DpdfMitLicense">
        <File Id="DpdfMitLicenseFile" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
      </Component>
      <Component Id="DpdfApacheLicense">
        <File Id="DpdfApacheLicenseFile" Source="$(var.BinDir)\LICENSE-APACHE" KeyPath="yes" />
      </Component>
      <Component Id="DpdfNotice">
        <File Id="DpdfNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="DpdfModels" Directory="ModelsFolder">
      <Files Include="$(var.ModelsDir)\*" />
    </ComponentGroup>
  </Fragment>
</Wix>
